DATABASE_URL=postgres://jodi:jodi@localhost:5433/jodi
JWT_SECRET=            # openssl rand -hex 32
BIRTH_KEY=             # openssl rand -hex 32  (encrypts birth details; never change after launch)
GEMINI_API_KEY=        # https://aistudio.google.com/apikey
GEMINI_MODEL=gemini-2.5-flash
ADMIN_TOKEN=           # long random string for /admin
OTP_DEV=true           # true = show OTP in app until an SMS provider is set. MUST be false in production.
DEMO_PHONE=9999999999  # fixed login for client demos / Play Store review
DEMO_OTP=123456
MSG91_AUTH_KEY=        # real SMS OTP (India)
MSG91_TEMPLATE_ID=
GOOGLE_CLIENT_IDS=     # comma-separated OAuth client IDs allowed for Google login
APP_DOWNLOAD_URL=      # where share-card visitors download the app
